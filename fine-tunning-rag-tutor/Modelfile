FROM ./llama-3.2-3b-instruct.Q4_K_M.gguf

# --- PARÁMETROS DE GENERACIÓN ---
# Obliga al modelo a permitir respuestas largas (hasta 2048 tokens)
PARAMETER num_predict 8192

# Temperatura para darle soltura argumentativa pero sin alucinar
PARAMETER temperature 0.3

# Ventana de memoria para leer los PDFs
PARAMETER num_ctx 4096

# --- PARÁMETROS DE CONTROL (No tocar) ---
PARAMETER stop "<|start_header_id|>"
PARAMETER stop "<|end_header_id|>"
PARAMETER stop "<|eot_id|>"

# --- PLANTILLA DE ENTRENAMIENTO LORA ---
TEMPLATE """{{ if .System }}<|start_header_id|>system<|end_header_id|>

{{ .System }}<|eot_id|>{{ end }}{{ if .Prompt }}<|start_header_id|>user<|end_header_id|>

{{ .Prompt }}<|eot_id|>{{ end }}<|start_header_id|>assistant<|end_header_id|>

{{ .Response }}<|eot_id|>"""